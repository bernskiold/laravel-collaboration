{
    "name": "bernskiold/laravel-collaboration",
    "description": "Share Eloquent records with other users. The package has permissions, events, notifications and an activity log. It has no user interface.",
    "keywords": [
        "bernskiold",
        "laravel",
        "collaboration",
        "sharing",
        "permissions"
    ],
    "homepage": "https://github.com/bernskiold/laravel-collaboration",
    "license": "MIT",
    "authors": [
        {
            "name": "Bernskiold",
            "email": "hello@bernskiold.com",
            "role": "Developer"
        },
        {
            "name": "Erik Bernskiöld",
            "email": "erik@bernskiold.com",
            "homepage": "https://bernskiold.com",
            "role": "Developer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/events": "^12.0 || ^13.0",
        "illuminate/notifications": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0 || ^9.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0",
        "phpstan/phpstan": "^2.1",
        "spatie/laravel-activitylog": "^4.10 || ^5.0"
    },
    "suggest": {
        "spatie/laravel-activitylog": "Records each change to the shares of a record in the activity log of the record."
    },
    "autoload": {
        "psr-4": {
            "Bernskiold\\LaravelCollaboration\\": "src/",
            "Bernskiold\\LaravelCollaboration\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bernskiold\\LaravelCollaboration\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bernskiold\\LaravelCollaboration\\LaravelCollaborationServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --memory-limit=2G"
    }
}
